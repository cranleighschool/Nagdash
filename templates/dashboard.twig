{% for error in errors %}
    <div class="status_red">{{ error }}</div>
{% endfor %}

<div id="info-window">
    <button class="close" onClick='$("#info-window").fadeOut("fast");'>&times;</button>
    <div id="info-window-text"></div>
</div>

<div class="sframes-row">
<div class="frame">
    <div class="section">
        <div class="header">
            <h3>Host status</h3>
            <p class="totals"><b>Total:</b>
                {% for state, count in host_summary %}
                    <span class="{{ nagios_host_status_colour[state] }}">{{ count }}</span>
                {% endfor %}
            </p>
        </div>

        {% if down_hosts|length > 0 %}
            <table id="broken_hosts" class="widetable">
                <tr>
                    <th>Hostname</th>
                    <th>State</th>
                    <th>Duration</th>
{#                    <th>Attempts</th>#}
                                    <th>Detail</th>
                </tr>
                {% for host in down_hosts %}
                    <tr id="host_row" class="{{ nagios_host_status_colour[host.host_state] }}">
                        <td>{{ host.hostname }} {{ host.tag_html|raw }} <span class="controls">
                    {% include 'partials/controls.twig' with {'tag': host.tag, 'host': host.hostname, 'service': ''} %}
                </span></td>
                        <td>
                            <blink>{{ nagios_host_status[host.host_state] }}</blink>
                        </td>
                        <td>{{ host.duration }}</td>
                        {#                <td>{{ host.current_attempt }}/{{ host.max_check_attempts }}</td> #}
                        <td class="desc">{{ host.detail }}</td>
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            <table class="widetable status_green">
                <tr>
                    <td><b>All hosts OK</b></td>
                </tr>
            </table>
        {% endif %}

        {% if known_hosts|length > 0 %}
            {% set known_host_items = [] %}
            {% for host in known_hosts %}
                {% set status_text = "" %}
                {% if host.is_ack %}{% set status_text = "ack" %}{% endif %}
                {% if host.is_downtime %}{% set status_text = "downtime" %}{% endif %}
                {% if not host.is_enabled %}{% set status_text = "disabled" %}{% endif %}
                {% set known_host_items = known_host_items|merge([
                    host.hostname ~ ' ' ~ host.tag_html ~ "<span class='known_hosts_desc'>(" ~ status_text ~ " - " ~ host.duration ~ ")</span>"
                ]) %}
            {% endfor %}
            <table class="widetable known_hosts">
                <tr>
                    <td>
                        <b>Known Problem Hosts: </b> {{ known_host_items|join(" &bull; ")|raw }}
                    </td>
                </tr>
            </table>
        {% endif %}

    </div>
</div>

<div class="frame">
    <div class="section">
        <div class="header">
            <h3>Service status</h3>
            <p class="totals"><b>Total:</b>
                {% for state, count in service_summary %}
                    <span class="{{ nagios_service_status_colour[state] }}">{{ count }}</span>
                {% endfor %}
            </p>
        </div>

        {% if broken_services|length > 0 %}
            <table class="widetable" id="broken_services">
                <tr>
                    <th>Hostname</th>
                    <th>Service</th>
                    <th width="6%">Duration</th>
                    {#                <th width="5%">Attempt</th> #}
                </tr>
                {% for service in broken_services %}
                    {% set soft_style = service.is_hard ? "" : "status_soft" %}
                    {% set blink_open  = (service.is_hard and enable_blinking) ? "<blink>" : "" %}
                    {% set blink_close = (service.is_hard and enable_blinking) ? "</blink>" : "" %}
                    <tr>
                        <td>{{ service.hostname }} {{ service.tag_html|raw }} <span class="controls">
                    {% include 'partials/controls.twig' with {'tag': service.tag, 'host': service.hostname, 'service': service.service_name} %}
                </span></td>
                        <td class="{{ nagios_service_status_colour[service.service_state] }} {{ soft_style }}"><span
                                    class="bold">{{ blink_open|raw }}{{ service.service_name }}</span><span
                                    class="detail">{{ service.detail }}</span>{{ blink_close|raw }}</td>
                        <td>{{ service.duration }}</td>
                        {#                <td>{{ service.current_attempt }}/{{ service.max_attempts }}</td> #}
                    </tr>
                {% endfor %}
            </table>
        {% else %}
            <table class="widetable status_green">
                <tr>
                    <td><b>All services OK</b></td>
                </tr>
            </table>
        {% endif %}

        {% if known_services|length > 0 %}
            <h4 class="known-problems-toggle" data-bs-toggle="collapse" data-bs-target="#known_services_collapse" aria-expanded="false">
                <span class="toggle-icon">&#9654;</span> Known Service Problems ({{ known_services|length }})
            </h4>
            <div id="known_services_collapse" class="collapse">
            <table class="widetable known_service" id="known_services">
                <tr>
                    <th>Hostname</th>
                    <th>Service</th>
                    <th width="18%">State</th>
                    <th width="10%">Duration</th>
                    {#                <th width="5%">Attempt</th> #}
                </tr>
                {% for service in known_services %}
                    {% set status_text = "" %}
                    {% if service.is_ack %}{% set status_text = "ack" %}{% endif %}
                    {% if service.is_downtime %}{% set status_text = "downtime " ~ service.downtime_remaining %}{% endif %}
                    {% if not service.is_enabled %}{% set status_text = "disabled" %}{% endif %}
                    <tr class="known_service">
                        <td>{{ service.hostname }} {{ service.tag_html|raw }}</td>
                        <td>{{ service.service_name }}</td>
                        <td class="{{ nagios_service_status_colour[service.service_state] }}">{{ nagios_service_status[service.service_state] }}
                            ({{ status_text }})
                        </td>
                        <td>{{ service.duration }}</td>
                        {#                <td>{{ service.current_attempt }}/{{ service.max_attempts }}</td> #}
                    </tr>
                {% endfor %}
            </table>
            </div>
        {% endif %}

    </div>
</div>
</div>{# end frames-row #}

<!-- nagios-api server status: -->
{% for server, stats in curl_stats %}
    <!-- {{ stats.url }} returned code {{ stats.http_code }}, {{ stats.size_download }} bytes in {{ stats.total_time }} seconds (first byte: {{ stats.starttransfer_time }}). JSON parsed {{ stats.objects|default('') }} hosts -->
{% endfor %}
