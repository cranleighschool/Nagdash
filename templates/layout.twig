<!DOCTYPE html>
<html>
<head>
<title>Nagios Dashboard</title>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js" integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo=" crossorigin="anonymous"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
<script type="text/javascript">
document.refresh_every_ms = {{ refresh_every_ms }};
document.csrf_token = "{{ csrf_token }}";
</script>
<script src="js/nagdash.js"></script>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" crossorigin="anonymous">
<link rel="stylesheet" href="css/blinkftw.css">
<link rel="stylesheet" href="css/main.css?34">
<style type="text/css">
{% for host in nagios_hosts %}
  .tag_{{ host.tag }} { background-color: {{ host.tagcolour }} }
{% endfor %}
</style>
{% if extra_css %}
<link rel="stylesheet" href="{{ extra_css }}">
{% endif %}
</head>
<body{% if theme == 'dark' %} class="dark"{% elseif theme == 'light' %} class="light"{% endif %}>
  <div id="spinner"><h3><img src="images/ajax-loader.gif" align="absmiddle"> Refreshing...</h3></div>
  <div id="nagioscontainer"></div>
  {% include 'partials/settings.twig' %}

<script>
    $(document).keypress(function(e) {
        if (e.which == 115) { // "s"
            new bootstrap.Modal(document.getElementById('settings_modal')).show();
        }
    });
    $(document).ready(load_nagios_data({{ show_refresh_spinner ? 'true' : 'false' }}));
</script>
</body>
</html>
