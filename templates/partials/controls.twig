<div class="btn-group">
    <a href="#" onclick="nagios_action('{{ tag }}', '{{ host }}', '{{ service }}', 'ack'); return false;" class="btn btn-sm btn-light">
        <i class="bi bi-check"></i> Ack
    </a>
    {% if service == '' %}
    <a href="#" onclick="nagios_action('{{ tag }}', '{{ host }}', '{{ service }}', 'disable'); return false;" class="btn btn-sm btn-light">
        <i class="bi bi-volume-mute"></i> Silence
    </a>
    {% else %}
    <a href="#" onclick="nagios_action('{{ tag }}', '{{ host }}', '{{ service }}', 'enable'); return false;" class="btn btn-sm btn-light">
        <i class="bi bi-volume-mute"></i> Unsilence
    </a>
    {% endif %}
    <div class="btn-group">
        <a class="btn btn-sm btn-light dropdown-toggle" data-bs-toggle="dropdown" href="#" role="button">
            <i class="bi bi-clock"></i> Downtime
        </a>
        <ul class="dropdown-menu dropdown-menu-end">
            {% for name, minutes in timespans %}
            <li><a class="dropdown-item" href="#" onclick="nagios_action('{{ tag }}', '{{ host }}', '{{ service }}', 'downtime', '{{ minutes }}'); return false;">{{ name }}</a></li>
            {% endfor %}
        </ul>
    </div>
</div>
