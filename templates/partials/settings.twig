<div id="settings_modal" class="modal hide fade" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-header">
        <button type="button" class="close" data-dismiss="modal" aria-hidden="true">&times;</button>
        <h3>Nagdash Settings</h3>
    </div>
    <div class="modal-body">
        <form id="settings-form" action="do_settings.php" method="post">
            <fieldset>
                <legend>Instances to show</legend>
                {% for host in nagios_hosts %}
                <label class="checkbox inline tag_label tag_{{ host.tag }}">
                    <input type="checkbox" name="{{ host.tag }}" value="{{ host.tag }}"
                        {% if host.tag not in unwanted_hosts %}checked{% endif %}>
                    {{ host.tag }}
                </label>
                {% endfor %}
            </fieldset>

            <fieldset>
                <legend>Hostname regex</legend>
                <input type="text" name="hostfilter" value="{{ cookie_hostfilter|e }}">
            </fieldset>

            <legend>Last state change</legend>
            <div class="settings_group">
                <span class="settings_element">
                    <select name="select_last_state_change" style="width:110px;">
                        {% for time_in_seconds, time_in_english in select_last_state_change_options %}
                        <option value="{{ time_in_seconds }}"
                            {% if cookie_select_last_state_change is not null and cookie_select_last_state_change == time_in_seconds %}selected{% endif %}>
                            {{ time_in_english }}
                        </option>
                        {% endfor %}
                    </select>
                </span>
                <span class="settings_element"> ago</span>

                <legend>Sort options</legend>
                {% if sort_by_time %}
                    {% set sort_by_time_checked = not (cookie_sort_by_time is not null and cookie_sort_by_time == 0) %}
                {% else %}
                    {% set sort_by_time_checked = (cookie_sort_by_time is not null and cookie_sort_by_time == 1) %}
                {% endif %}
                {% set sort_descending_checked = (cookie_sort_descending is not null and cookie_sort_descending == 1) %}

                <span class="settings_element">
                    Sort by time?
                    <label class="checkbox inline tag_label">
                        <input type="checkbox" name="sort_by_time" {% if sort_by_time_checked %}checked{% endif %}>
                    </label>
                </span>
                <span class="settings_element">
                    Descending?
                    <label class="checkbox inline tag_label">
                        <input type="checkbox" name="sort_descending" {% if sort_descending_checked %}checked{% endif %}>
                    </label>
                </span>
            </div>
        </form>
    </div>
    <div class="modal-footer">
        <button class="btn" data-dismiss="modal" aria-hidden="true">Close</button>
        <button class="btn btn-primary" onclick="$('#settings-form').submit();">Save changes</button>
    </div>
</div>
