<div id="settings_modal" class="modal fade" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nagdash Settings</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="settings-form" action="do_settings.php" method="post">
                    <fieldset>
                        <legend>Instances to show</legend>
                        {% for host in nagios_hosts %}
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="host_{{ host.tag }}" name="{{ host.tag }}" value="{{ host.tag }}"
                                {% if host.tag not in unwanted_hosts %}checked{% endif %}>
                            <label class="form-check-label tag_label tag_{{ host.tag }}" for="host_{{ host.tag }}">
                                {{ host.tag }}
                            </label>
                        </div>
                        {% endfor %}
                    </fieldset>

                    <fieldset class="mt-3">
                        <legend>Hostname regex</legend>
                        <input type="text" class="form-control" name="hostfilter" value="{{ cookie_hostfilter|e }}">
                    </fieldset>

                    <fieldset class="mt-3">
                        <legend>Last state change</legend>
                        <div class="settings_group">
                            <span class="settings_element">
                                <select class="form-select" name="select_last_state_change" style="width:110px;">
                                    {% for time_in_seconds, time_in_english in select_last_state_change_options %}
                                    <option value="{{ time_in_seconds }}"
                                        {% if cookie_select_last_state_change is not null and cookie_select_last_state_change == time_in_seconds %}selected{% endif %}>
                                        {{ time_in_english }}
                                    </option>
                                    {% endfor %}
                                </select>
                            </span>
                            <span class="settings_element"> ago</span>
                        </div>
                    </fieldset>

                    <fieldset class="mt-3">
                        <legend>Theme</legend>
                        <div class="settings_group">
                            {% for value, label in {'auto': 'Auto (OS)', 'light': 'Light', 'dark': 'Dark'} %}
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" id="theme_{{ value }}" name="theme" value="{{ value }}"
                                    {% if cookie_theme == value or (cookie_theme is null and value == 'auto') %}checked{% endif %}>
                                <label class="form-check-label" for="theme_{{ value }}">{{ label }}</label>
                            </div>
                            {% endfor %}
                        </div>
                    </fieldset>

                    <fieldset class="mt-3">
                        <legend>Sort options</legend>
                        {% if sort_by_time %}
                            {% set sort_by_time_checked = not (cookie_sort_by_time is not null and cookie_sort_by_time == 0) %}
                        {% else %}
                            {% set sort_by_time_checked = (cookie_sort_by_time is not null and cookie_sort_by_time == 1) %}
                        {% endif %}
                        {% set sort_descending_checked = (cookie_sort_descending is not null and cookie_sort_descending == 1) %}

                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="sort_by_time" name="sort_by_time" {% if sort_by_time_checked %}checked{% endif %}>
                            <label class="form-check-label" for="sort_by_time">Sort by time?</label>
                        </div>
                        <div class="form-check form-check-inline">
                            <input class="form-check-input" type="checkbox" id="sort_descending" name="sort_descending" {% if sort_descending_checked %}checked{% endif %}>
                            <label class="form-check-label" for="sort_descending">Descending?</label>
                        </div>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-primary" onclick="$('#settings-form').submit();">Save changes</button>
            </div>
        </div>
    </div>
</div>
